# Notion API Configuration
# Get your API key from https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_notion_api_key_here

# The ID of the database where messages will be saved.
# You can find this in the URL of your Notion database.
# E.g., https://www.notion.so/workspace/1234567890abcdef?v=... -> Database ID is 1234567890abcdef
NOTION_DATABASE_ID=your_database_id_here
